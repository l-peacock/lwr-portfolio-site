{
	"lwc": {
		"modules": [{ "dir": "$rootDir/src/modules" }]
	},
	"routes": [
		{
			"id": "base",
			"path": "/",
			"rootComponent": "base/app",
			"layoutTemplate": "$layoutsDir/main.html",
			"properties": {
				"title": "Lachlan Peacock",
				"description": "My personal website and portfolio!",
				"keywords": "Lachlan, Peacock, JavaScript, Salesforce, Developer",
				"author": "Lachlan Peacock"
			}
		}
	],
	"assets": [
		{
			"alias": "assetsDir",
			"dir": "$rootDir/src/assets",
			"urlPath": "/public/assets"
		},
		{
			"alias": "favicon",
			"file": "$rootDir/src/assets/favicon.ico",
			"urlPath": "/favicon.ico"
		},
		{
			"alias": "cname",
			"file": "$rootDir/src/CNAME",
			"urlPath": "/CNAME"
		},
		{
			"alias": "nojekyll",
			"file": "$rootDir/src/.nojekyll",
			"urlPath": "/.nojekyll"
		}
	]
}
